# Python bytecode / caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# PyInstaller build output
build/
dist/
# PyInstaller .spec is generated by build.py; never commit a machine-specific one.
*.spec

# Editor / OS / agent cruft
.vscode/
.idea/
.claude/
*.swp
.DS_Store
Thumbs.db

# Scratch files used during development checks
_*.py
# ...but not legitimate underscore-prefixed modules the app/tests ship with.
!Reclaim/__main__.py
!tests/_support.py

# Internal dev notes not meant for the public repo
# (history.md = chronological build log; CLAUDE.md = AI-agent working instructions)
history.md
CLAUDE.md
